{
  "target": {
    "_json": {
      "project_id": "vtproject-json"
    },
    "json": {
      "target": "artifact",
      "description": "reads the project of _json",
      "args": {
        "MESSAGE": "${target._json.project_id}",
        "LITERAL": "target._json.project_id",
        "NESTED": "${merge({}, {id = target._json.project_id}).id}"
      },
      "output": [
        "type=local,dest=out-json"
      ]
    }
  }
}
